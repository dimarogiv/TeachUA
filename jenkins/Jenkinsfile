pipeline {
  agent any
  stages {
    stage ('build front') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          pwd
          CI='' ansible-playbook -i inventory.gcp.yml site.yml --tags='build_front'
          '''
      }
    }
    stage ('build back') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='build_back'
          '''
      }
    }
    stage ('build back docker image') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='build_back_img'
          '''
      }
    }
    stage ('build front docker image') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='build_front_img'
          '''
      }
    }
    stage ('setup controlplane') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='setup_controlplane'
          '''
      }
    }
    stage ('setup worker nodes') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='setup_worker_nodes'
          '''
      }
    }
    stage ('deploy site') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='deploy_site'
          '''
      }
    }
  }
}
