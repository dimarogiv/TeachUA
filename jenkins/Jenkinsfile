pipeline {
  agent any
  stages {
    stage ('Test') {
      steps {
        echo 'Hello world!'
        echo 'another step'
      }
    }
    stage ('build front') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          node --version
          nvm use v14.17.4 || true
          node --version
          source /usr/share/nvm/init-nvm.sh
          nvm use v14.17.4
          node --version
          
          echo '##############################################'
          ls -a backend
          echo '##############################################'
          ls -a frontend
          echo '##############################################'
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='build_front'
          '''
      }
    }
    stage ('build back') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='build_back'
          '''
      }
    }
    stage ('build back docker image') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='build_back_img'
          '''
      }
    }
    stage ('build front docker image') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='build_front_img'
          '''
      }
    }
    stage ('install docker') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='install_docker'
          '''
      }
    }
    stage ('run backend') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='run_backend'
          '''
      }
    }
    stage ('run frontend') {
      steps {
        sh '''
          COPY_PATH=~/.config/teachua
          git submodule update --init --recursive || true
          cp -rn $COPY_PATH/* .
          '''
        sh '''
          cd ansible/gcp
          ansible-playbook -i inventory.gcp.yml site.yml --tags='run_frontend'
          '''
      }
    }
  }
}
